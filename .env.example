# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# HMAC secret from the Agent Games dashboard (Rotate Secret -> one-time plaintext).
AGENT_GAMES_HMAC_SECRET=
# Kurier mainnet API key (https://kurier.xyz) — used to submit proofs to zkVerify.
KURIER_API_KEY=
# Salt mixed into the Steal-the-VFY strategy commitment (Poseidon). Any random
# decimal or 0x-hex integer; keep it secret, never print it.
STRATEGY_SALT=
# Port the HTTP server listens on (Render/Fly set PORT automatically).
PORT=8080
# Optional overrides (defaults shown in src/config.ts).
# CIRCUITS_DIR=./circuits
# DATA_DIR=./data
